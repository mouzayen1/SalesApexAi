{
  "description": "10-deal test suite for accuracy validation",
  "version": "1.0.0",
  "lastUpdated": "2025-01-13",
  "deals": [
    {
      "id": "deal_001",
      "description": "Standard subprime deal - older vehicle",
      "input": {
        "vehicleId": "test-001",
        "vehicleYear": 2018,
        "vehicleMake": "Honda",
        "vehicleMileage": 65000,
        "vehiclePrice": 18000,
        "vehicleCost": 14500,
        "taxRate": 0.0925,
        "fees": 495,
        "downPayment": 2000,
        "tradeAllowance": 0,
        "tradePayoff": 0,
        "backendProducts": { "gap": true, "vsc": false, "otherProductsTotal": 0 },
        "customerCreditTier": "subprime",
        "targetPayment": 450,
        "paymentTolerance": 50
      },
      "expected": {
        "hasValidCandidates": true,
        "bestLender": "western_funding",
        "paymentRange": { "min": 350, "max": 550 },
        "shouldRecommendGap": true,
        "shouldRecommendVsc": true,
        "notes": "Honda preferred at Western Funding, out of warranty due to age (8+ years) and mileage"
      }
    },
    {
      "id": "deal_002",
      "description": "Deep subprime with Kia theft risk",
      "input": {
        "vehicleId": "test-002",
        "vehicleYear": 2017,
        "vehicleMake": "Kia",
        "vehicleMileage": 85000,
        "vehiclePrice": 12000,
        "vehicleCost": 9000,
        "taxRate": 0.08,
        "fees": 450,
        "downPayment": 1500,
        "tradeAllowance": 0,
        "tradePayoff": 0,
        "backendProducts": { "gap": false, "vsc": false, "otherProductsTotal": 0 },
        "customerCreditTier": "deep_subprime",
        "targetPayment": 350,
        "paymentTolerance": 50
      },
      "expected": {
        "hasValidCandidates": true,
        "vehicleWarningsExpected": true,
        "advanceMultiplierLessThan1": true,
        "notes": "Should have theft risk penalty applied"
      }
    },
    {
      "id": "deal_003",
